{
  "name": "openkart",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:https": "OPENKART_HTTPS=1 vite --host 0.0.0.0",
    "dev:phone": "OPENKART_HTTPS=1 PORT=5181 vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:relay": "node scripts/test-relay.mjs"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "three": "^0.180.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/qrcode": "^1.5.5",
    "@types/three": "^0.180.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "happy-dom": "^20.14.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
